# Shared environment variables for the OpenVLA × LIBERO project.
# First-time setup:
#   cp code/env.sh.example code/env.sh
#   $EDITOR code/env.sh     # fill in the <...> placeholders
# Then source from every interactive session and every sbatch script:
#   source $VLA_ROOT/code/env.sh

# Project root: parent of openvla/, LIBERO/, runs/, datasets/, logs/, rollouts/
export VLA_ROOT=<your_vla_root>

# HuggingFace cache — large; put on fast storage with plenty of free space
export HF_HOME=<your_hf_cache>
export HF_HUB_ENABLE_HF_TRANSFER=1

# LIBERO / MuJoCo headless rendering — egl on GPU nodes, osmesa as CPU fallback
export MUJOCO_GL=egl

# Weights & Biases routing
export WANDB_PROJECT=openvla-libero
export WANDB_ENTITY=<your_wandb_entity>

# Derived paths (no edit needed)
export VLA_RUNS=$VLA_ROOT/runs
export VLA_DATASETS=$VLA_ROOT/datasets
export VLA_LOGS=$VLA_ROOT/logs
export VLA_ROLLOUTS=$VLA_ROOT/rollouts
